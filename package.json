{
  "name": "nidavellir-dashboard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "collector": "node collector/server.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test collector/collector.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"collector/**/*.mjs\" \"*.{json,js,ts,md,html}\" \"docker-compose.yml\" \"pnpm-workspace.yaml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"collector/**/*.mjs\" \"*.{json,js,ts,md,html}\" \"docker-compose.yml\" \"pnpm-workspace.yaml\""
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
